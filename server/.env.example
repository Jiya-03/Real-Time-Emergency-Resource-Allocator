# Copy this file to .env (same folder) and fill in your values. .env is NOT committed to git.

# Mapbox public access token (starts with pk.) from https://account.mapbox.com/access-tokens/
# Used for the live street / traffic / satellite map and traffic-aware driving directions.
# Without it the app falls back to free CARTO tiles + OSRM routing.
MAPBOX_TOKEN=

# Optional
# PORT=5000
# SIMULATOR=off

# ── Database (optional) ───────────────────────────────────────────────────
# Empty = local SQLite file (default, works offline).
# Set it to use Postgres directly, e.g. Supabase → Connect → Session pooler (port 5432):
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# ── Supabase live sync (optional) ─────────────────────────────────────────
# SQLite mode: live mirror of everything to Supabase. Postgres mode: dashboard edits refresh every screen.
# Project URL and SERVICE ROLE key from Supabase → Project Settings → API.
# The service role key is SECRET: keep it only in this file, never in git or the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Dispatch cascade (optional; defaults shown)
# BROADCAST_MAX=3          # hospitals per wave
# ETA_BAND_MIN=10          # a wave only includes hospitals at most this many minutes slower than the best one
# SCORE_BAND=0.85          # ...and scoring at least this share of the best score
# RESPONSE_SECONDS=60      # time a hospital has to answer
# BETTER_WAIT_SECONDS=30   # how long a lower-ranked "yes" waits for better-ranked hospitals
