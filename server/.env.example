# Copy this file to .env (same folder) and fill in your values. .env is NOT committed to git.

# Mapbox public access token (starts with pk.) from https://account.mapbox.com/access-tokens/
# Used for the live street / traffic / satellite map and traffic-aware driving directions.
# Without it the app falls back to free CARTO tiles + OSRM routing.
MAPBOX_TOKEN=

# Optional
# PORT=5000
# SIMULATOR=off

# ── Supabase live sync (optional) ─────────────────────────────────────────
# Project URL and SERVICE ROLE key from Supabase → Project Settings → API.
# The service role key is SECRET: keep it only in this file, never in git or the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
